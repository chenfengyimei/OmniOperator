 "root_cause": "Frame registration checked worker metadata bounds and actual bytes/hash but ignored independent image inspection dimensions and format. Hash-correct mismatched dimensions or JPEG bytes could be published as successful PNG frame artifacts.",
 "changes": [
  "Compare independently verified image width and height with the validated worker claim",
  "Require the verified media type to be image/png before returning frame artifact metadata",
  "Use media_sheet_invalid for missing/mismatched dimensions or format; do not commit a media frame row",
  "Keep byte/hash checks, publication/authorization order, ImageService reuse, existing object/image GC semantics and explicit fresh work",
  "Update only metadata fields returned by two independent image fakes; retain all prior assertions"
 ],
