 "changes": [
  "Share the existing processing deadline across stdin write/drain and stdout read",
  "Reclaim on stream-limit ValueError or IPC OSError and preserve timeout versus uncertain-failure codes",
  "Require complete newline framing, exact byte cap, integer version1, matching request identity and boolean outcome",
  "Reject duplicate JSON fields at all depths, non-finite constants/float overflow and excessive parser recursion",
  "Preserve valid worker business failures and live-worker reuse"
 ],
