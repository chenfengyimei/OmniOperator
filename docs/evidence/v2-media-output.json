 "root_cause": "Worker output was loaded with unbounded Path.read_bytes before metadata/size checks. ASR accepted a valid subtitle object under an ASR row, and an oversized valid JSON output could publish an object before its durable transcript row was rejected.",
 "changes": [
  "Read worker output once at most accepted bytes plus one, closing streams on success/error",
  "Validate sheet metadata before opening the file, then use its verified <=8MiB size as the read bound",
  "Reject ASR output beyond4MiB or with non-ASR kind before any object publication",
  "Keep valid bytes, SHA/length guards, normal job state handling and explicit later-job behavior"
 ],
 "proof": {
  "changed_existing_methods": [
   "_execute",
   "_register_sheet"
  ],
  "new_function": "_output_bytes",
  "execute_ast_identical_except_bounded_output_read_parse_cache_and_kind_guard": true,
  "sheet_metadata_and_publication_ast_identical_with_validation_moved_before_read": true,
  "admission_cleanup_and_close_methods_byte_identical": true,
  "domain_processor_worker_lifecycle_repository_files_byte_identical": [
   "agent/src/omni/domain/media.py",
   "agent/src/omni/adapters/media.py",
