# OmniOperator 密钥配置：复制为 .env 并填写，至少配一家。
# 前缀与 LiteLLM provider 对应：https://docs.litellm.ai/docs/providers
# 本地 Ollama（http://localhost:11434）不需要任何密钥。

# 国产（推荐先配一家跑通闭环）
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=          # 阿里 Qwen
ZHIPU_API_KEY=              # 智谱 GLM
ARK_API_KEY=                # 火山引擎 豆包
OPENROUTER_API_KEY=

# 海外（视觉/UI 定位强，需要网络可达）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
