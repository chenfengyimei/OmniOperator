    {
      "id": "coding-multi-file",
      "category": "coding",
      "prompt": "实现 reader.py 的 read_rows(path) 和 main.py 的入口，标准输出每行一个数字；用 python check.py 验证。",
      "files": {
        "input.json": "[1,2,3]\n",
        "check.py": "import subprocess, sys\ndef check():\n    result = subprocess.run([sys.executable, \"main.py\"], check=True, capture_output=True, text=True)\n    assert result.stdout.strip().split() == [\"3\", \"2\", \"1\"], result.stdout\nif __name__ == \"__main__\":\n    check()\n"
      },
      "checks": [
        {
          "fact": "code_check_passed",
          "equals": true
        }
      ],
      "intervention": {}
    },
    {
      "id": "coding-validation",
      "category": "coding",
      "prompt": "实现在 submit.py 的 accept(value) -> bool；只允许大于等于零的整数，bool 不属于可接受输入。用 python check.py 验证。",
      "files": {
        "input.json": "{\"accept\":[0,1],\"reject\":[true,-1,\"1\"]}\n",
        "check.py": "from submit import accept\nassert all(accept(value) is True for value in (0, 1))\nassert all(accept(value) is False for value in (True, -1, \"1\"))\n"
      },
      "checks": [
        {
          "fact": "code_check_passed",
          "equals": true
        }
      ],
      "intervention": {}
    },
    {
      "id": "coding-regression",
      "category": "coding",
      "prompt": "实现在 reader.py 的 sort_rows(rows)，按第一列排序，同键保持输入顺序。用 python check.py 验证。",
      "files": {
        "input.json": "[[\"x\",1],[\"y\",2],[\"x\",3]]\n",
        "check.py": "from reader import sort_rows\nassert sort_rows([[\"x\",1],[\"y\",2],[\"x\",3]]) == [[\"x\",1],[\"x\",3],[\"y\",2]]\n"
      },
      "checks": [
        {
          "fact": "code_check_passed",
          "equals": true
        }
      ],
      "intervention": {}
    },
    {
      "id": "coding-small-context",
      "category": "coding",
      "prompt": "读取 spec-a.txt 和其引用的 spec-b.txt。在 main.py 实现，执行 python check.py 验证 result.tsv。",
      "files": {
        "input.json": "{\"columns\":[\"id\",\"name\"],\"items\":[[1,\"alpha\"]]}\n",
        "check.py": "import subprocess, sys\nfrom pathlib import Path\nsubprocess.run([sys.executable, \"main.py\"], check=True)\nassert Path(\"result.tsv\").read_text() == \"id\\tname\\n1\\talpha\\n\"\n",
        "spec-a.txt": "输入为 input.json。输出规范见 spec-b.txt。\n",
        "spec-b.txt": "以制表符连接 columns 与各行，在末尾保留换行。写入 result.tsv。\n"
      },
      "checks": [
        {
          "fact": "code_check_passed",
          "equals": true
        }
      ],
      "intervention": {}
    },
