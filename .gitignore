# Python
__pycache__/
*.pyc
.venv/
omni-build.json
.pytest_cache/

# 密钥
.env

# 真实运行配置（含私聊白名单、本机目录）——模板见 config.example.yaml
config/config.yaml

# 运行数据（SQLite 记忆库等）
data/

# 学习用参考项目（不进主仓库）
xuexi/

# 设计 / UI-UX 参考仓库（不进主仓库；见 sheji/README.md）
/sheji/

# 一键安装器下载的本地组件（NapCat / platform-tools），见 scripts/install.ps1
/tools/

# 技能编辑锁与本地运行数据（不进库）
skills/.locks/
skills/.history/
skills/.inbox/
skills/.quarantine/
skills/.archive/

# 本机 Agent 空间与目录选择（不提交个人绝对路径）
config/agents.json
config/agents.lock
*.yaml.lock

# 官网设计稿（独立静态站，不入库；见 website/README.md）
/website/

# 官方社区内容源（插件/人设市场，运营资产不入库；见 market/README.md）
/market/

# 产品重构后本机可选兼容联接；正式代码与测试只归 agent/
/src/
/tests/

# 评测/调试临时产物（不进版本库）
agent/.tmp/

# 本地资产与敏感资料（不入库）
/temp/
/PPT/

# 文档整理时保留的本机历史副本
/docs/temp/

/web/node_modules/

# Native helper compiler caches; source and lock files remain tracked.
/agent/src/omni/adapters/workers/macos/**/.build/
/agent/src/omni/adapters/workers/macos/**/.swiftpm/

# UI/UX 技能运行产物（Playwright 截图、impeccable 评审缓存，只留本机不入库）
/output/
/.impeccable/
