# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# 密钥
.env

# 真实运行配置（含私聊白名单、本机目录）——模板见 config.example.yaml
config/config.yaml

# 运行数据（SQLite 记忆库等）
data/

# 学习用参考项目（不进主仓库）
xuexi/

# 一键安装器下载的本地组件（NapCat / platform-tools），见 scripts/install.ps1
/tools/

# 技能编辑锁与本地运行数据（不进库）
skills/.locks/
skills/.history/
skills/.inbox/
skills/.quarantine/
skills/.archive/

# 本机 Agent 空间与目录选择（不提交个人绝对路径）
config/agents.json
config/agents.lock
*.yaml.lock

# 官网设计稿（独立静态站，不入库；见 website/README.md）
/website/

# 官方社区内容源（插件/人设市场，运营资产不入库；见 market/README.md）
/market/

# 产品重构后本机可选兼容联接；正式代码与测试只归 agent/
/src/
/tests/
